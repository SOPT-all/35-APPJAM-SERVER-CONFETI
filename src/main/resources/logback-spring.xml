<configuration>
  <include resource="console_appender.xml"/>
  <include resource="request_response_file_appender.xml"/>
  <include resource="warn_error_file_appender.xml"/>
  <include resource="exception_file_appender.xml"/>

  <logger additivity="false" level="INFO"
    name="org.sopt.confeti.global.interceptor.LoggingInterceptor">
    <appender-ref ref="REQUEST_RESPONSE_FILE"/>
  </logger>

  <logger additivity="false" level="ERROR"
    name="org.sopt.confeti.global.interceptor.ErrorNotificationInterceptor">
    <appender-ref ref="EXCEPTION_FILE"/>
  </logger>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="WARN_ERROR_FILE"/>
  </root>
</configuration>
